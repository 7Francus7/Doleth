generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum PlanKey {
  BASE
  PRO
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Tipo de cambio. En Argentina "el dólar" no es un número sino varios, y la
/// diferencia entre ellos cambia el patrimonio de una persona de forma material:
/// por eso cuál se usa es una decisión explícita y no un default escondido.
enum FxVariant {
  OFICIAL
  BLUE
  MEP
  CCL
  CRIPTO
  TARJETA
  MANUAL
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  ADMIN_PASSWORD_RESET
}

enum AuthEventType {
  ACCOUNT_CREATED
  PRIVATE_BETA_ADMIN_BOOTSTRAPPED
  PRIVATE_BETA_INVITATION_CREATED
  PRIVATE_BETA_INVITATION_CONSUMED
  PRIVATE_BETA_INVITATION_REJECTED
  ADMIN_PASSWORD_RESET_ISSUED
  EMAIL_VERIFIED
  VERIFICATION_RESENT
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  SESSIONS_REVOKED
  PROFILE_UPDATED
  ONBOARDING_COMPLETED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CANCELED
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String
  status                 UserStatus         @default(PENDING_VERIFICATION)
  role                   UserRole           @default(USER)
  emailVerifiedAt        DateTime?
  passwordChangedAt      DateTime           @default(now())
  lastLoginAt            DateTime?
  onboardingCompletedAt  DateTime?
  onboardingStep         Int                @default(0)
  primaryCurrency        String             @default("ARS")
  /// Moneda en la que la persona *lee* su dinero. No cambia nada de lo guardado:
  /// el ledger conserva cada importe en la moneda en que ocurrió y esto sólo
  /// decide en qué unidad se presenta el consolidado.
  displayCurrency        String             @default("ARS")
  /// Qué dólar usa para esa lectura. Cambiarlo cambia el patrimonio mostrado,
  /// así que es del usuario y no del sistema.
  fxVariant              FxVariant          @default(BLUE)
  timeZone               String             @default("America/Argentina/Cordoba")
  locale                 String             @default("es-AR")
  planKey                PlanKey            @default(BASE)
  subscriptionStatus     SubscriptionStatus @default(FREE)
  subscriptionStartedAt  DateTime?
  subscriptionEndsAt     DateTime?
  trialEndsAt            DateTime?
  deletionRequestedAt    DateTime?
  privateBetaActivatedAt DateTime?
  acceptedTermsAt        DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  sessions                  Session[]
  authTokens                AuthToken[]
  authEvents                AuthEvent[]
  privateBetaInvitesCreated PrivateBetaInvite[] @relation("PrivateBetaInviteCreator")
  privateBetaInviteConsumed PrivateBetaInvite?  @relation("PrivateBetaInviteConsumer")
  accounts                  Account[]
  categories                Category[]
  transactions              Transaction[]
  ledgerEntries             LedgerEntry[]
  investments               Investment[]
  upcomingPayments          UpcomingPayment[]
  manualRates               ManualRate[]
  creditCards               CreditCard[]

  @@index([status])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  newEmail   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  emailHash String?
  type      AuthEventType
  success   Boolean       @default(true)
  context   String?
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model PrivateBetaInvite {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  email        String
  createdById  String
  consumedById String?   @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  createdBy    User      @relation("PrivateBetaInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  consumedBy   User?     @relation("PrivateBetaInviteConsumer", fields: [consumedById], references: [id], onDelete: SetNull)

  @@index([email, expiresAt])
  @@index([createdById, createdAt])
  @@index([expiresAt])
}

model RateLimitCounter {
  bucket          String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}

/// Evidencia auditable de cada corrida del backfill de propiedad de datos.
model OwnerBackfillRun {
  id          String   @id @default(cuid())
  ownerUserId String
  dryRun      Boolean  @default(false)
  counts      String
  createdAt   DateTime @default(now())

  @@index([ownerUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Cotizaciones
// ---------------------------------------------------------------------------

/// Cotización pública, tal como la publicó un proveedor.
///
/// Es la única tabla del dominio financiero sin propietario, y a propósito: el
/// precio del dólar no es un dato personal. Que una persona lo consulte no dice
/// nada de su patrimonio, así que compartir la fila entre todos no rompe el
/// aislamiento —no hay nada de nadie adentro— y evita pedirle la misma
/// cotización al proveedor una vez por usuario.
model MarketRate {
  id            String    @id @default(cuid())
  /// Moneda fuerte del par: `rateMicros` dice cuánto vale **una** unidad de ésta.
  baseCurrency  String
  quoteCurrency String
  variant       FxVariant
  /// Unidades de `quoteCurrency` por 1 de `baseCurrency`, en millonésimas enteras.
  rateMicros    BigInt
  provider      String
  /// Momento que declara el proveedor. No es cuándo Doleth la bajó: una
  /// cotización de ayer sigue siendo de ayer aunque se lea hoy.
  asOf          DateTime
  fetchedAt     DateTime  @default(now())

  @@unique([baseCurrency, quoteCurrency, variant, asOf])
  @@index([baseCurrency, quoteCurrency, variant, asOf])
}

/// Cotización propia. Manda sobre la pública mientras esté vigente.
///
/// Existe porque mucha gente compró sus dólares a un precio concreto, o usa una
/// referencia que ningún proveedor publica. Obligarla a leer su patrimonio a un
/// número que no reconoce como suyo sería negarle la realidad que Doleth dice
/// ordenar.
model ManualRate {
  id            String   @id @default(cuid())
  userId        String
  baseCurrency  String
  quoteCurrency String
  rateMicros    BigInt
  note          String?
  asOf          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseCurrency, quoteCurrency, asOf])
  @@index([userId, baseCurrency, quoteCurrency, asOf])
}

// ---------------------------------------------------------------------------
// Finanzas
// ---------------------------------------------------------------------------

enum AccountType {
  CASH
  BANK
  WALLET
  SAVINGS
  /// Tarjeta de crédito: una deuda, no un lugar donde hay plata.
  ///
  /// Vive en el ledger como cualquier otra cuenta y con el mismo signo —gastar
  /// deja el saldo en negativo— pero significa lo contrario. El tipo es la
  /// declaración: no hace falta una columna aparte para saber que es pasivo.
  CREDIT_CARD
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum UpcomingPaymentStatus {
  PENDING
  PAID
}

enum InvestmentKind {
  STOCKS
  CRYPTO
  FUND
  BOND
  REAL_ESTATE
  CASH_EQUIVALENT
  OTHER
}

enum InvestmentStatus {
  ACTIVE
  ARCHIVED
}

model Account {
  id                  String            @id @default(cuid())
  /// Propietario. Obligatorio desde 202607280001_require_financial_ownership.
  userId              String
  name                String
  type                AccountType
  currency            String            @default("ARS")
  initialBalanceCents BigInt
  status              AccountStatus     @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries             LedgerEntry[]
  sourceTransactions  Transaction[]     @relation("TransactionSource")
  targetTransactions  Transaction[]     @relation("TransactionTarget")
  upcomingPayments    UpcomingPayment[]
  creditCard          CreditCard?

  @@unique([id, userId])
  @@index([status])
  @@index([userId, status])
}

/// Los datos que una tarjeta tiene y una cuenta común no.
///
/// Vive aparte de `Account` en vez de agregarle seis columnas nulas a todas las
/// cuentas del producto. La relación es uno a uno con la cuenta-deuda: la
/// tarjeta *es* esa cuenta, esto sólo agrega lo que hace falta para saber cuándo
/// cierra y cuándo vence.
model CreditCard {
  id               String   @id @default(cuid())
  userId           String
  /// Cuenta del ledger que representa la deuda de esta tarjeta.
  accountId        String   @unique
  brand            String?
  /// Últimos cuatro dígitos. Es lo único del número que Doleth guarda, y sirve
  /// para reconocer la tarjeta en un resumen o en un aviso de consumo.
  last4            String?
  /// Día del mes en que cierra el resumen.
  closingDay       Int
  /// Día del mes en que vence el pago.
  dueDay           Int
  creditLimitCents BigInt?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  account          Account  @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([accountId, userId])
  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  slug         String
  name         String
  kind         CategoryKind
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([id, userId])
  @@unique([userId, slug])
  @@index([kind])
  @@index([userId, kind])
}

model Transaction {
  id                   String           @id @default(cuid())
  userId               String
  type                 TransactionType
  amountCents          BigInt
  /// Moneda de `amountCents`: siempre la de la cuenta de origen. Se denormaliza
  /// para que un movimiento se pueda leer sin resolver la cuenta, y para que
  /// cambiar de opinión sobre una cuenta no reescriba la historia de sus
  /// movimientos.
  currency             String           @default("ARS")
  /// Importe acreditado en la cuenta de destino, cuando la transferencia cruza
  /// monedas. `null` cuando ambas puntas usan la misma: ahí entra y sale lo
  /// mismo y guardarlo dos veces sería invitar a que se desincronicen.
  destinationAmountCents BigInt?
  occurredOn           DateTime         @db.Date
  description          String?
  sourceAccountId      String
  destinationAccountId String?
  categoryId           String?
  idempotencyKey       String
  voidedAt             DateTime?
  voidReason           String?
  correctedFromId      String?          @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceAccount        Account          @relation("TransactionSource", fields: [sourceAccountId, userId], references: [id, userId], onDelete: Restrict)
  destinationAccount   Account?         @relation("TransactionTarget", fields: [destinationAccountId, userId], references: [id, userId], onDelete: Restrict)
  category             Category?        @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  entries              LedgerEntry[]
  correctedFrom        Transaction?     @relation("CorrectionChain", fields: [correctedFromId, userId], references: [id, userId], onDelete: Restrict)
  correction           Transaction?     @relation("CorrectionChain")
  upcomingPayment      UpcomingPayment?

  @@unique([id, userId])
  @@unique([correctedFromId, userId])
  @@unique([userId, idempotencyKey])
  @@index([occurredOn])
  @@index([type, occurredOn])
  @@index([sourceAccountId, occurredOn])
  @@index([destinationAccountId, occurredOn])
  @@index([userId, occurredOn])
  @@index([userId, type, occurredOn])
}

model LedgerEntry {
  id            String      @id @default(cuid())
  userId        String
  transactionId String
  accountId     String
  amountCents   BigInt
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction   Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)
  account       Account     @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)

  @@index([accountId])
  @@index([transactionId])
  @@index([userId, accountId])
}

model Investment {
  id                String           @id @default(cuid())
  userId            String
  name              String
  kind              InvestmentKind
  symbol            String?
  currency          String           @default("ARS")
  investedCents     BigInt
  currentValueCents BigInt
  note              String?
  status            InvestmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([kind])
  @@index([userId, status])
}

model UpcomingPayment {
  id               String                @id @default(cuid())
  userId           String
  concept          String
  estimatedCents   BigInt
  dueOn            DateTime              @db.Date
  frequency        String?
  plannedAccountId String
  status           UpcomingPaymentStatus @default(PENDING)
  transactionId    String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  plannedAccount   Account               @relation(fields: [plannedAccountId, userId], references: [id, userId], onDelete: Restrict)
  transaction      Transaction?          @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([transactionId, userId])
  @@index([status, dueOn])
  @@index([userId, status, dueOn])
}
