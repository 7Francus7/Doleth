generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum PlanKey {
  BASE
  PRO
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum AuthEventType {
  ACCOUNT_CREATED
  EMAIL_VERIFIED
  VERIFICATION_RESENT
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  SESSIONS_REVOKED
  PROFILE_UPDATED
  ONBOARDING_COMPLETED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CANCELED
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  passwordHash          String
  status                UserStatus         @default(PENDING_VERIFICATION)
  role                  UserRole           @default(USER)
  emailVerifiedAt       DateTime?
  passwordChangedAt     DateTime           @default(now())
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  onboardingStep        Int                @default(0)
  primaryCurrency       String             @default("ARS")
  timeZone              String             @default("America/Argentina/Cordoba")
  locale                String             @default("es-AR")
  planKey               PlanKey            @default(BASE)
  subscriptionStatus    SubscriptionStatus @default(FREE)
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  trialEndsAt           DateTime?
  deletionRequestedAt   DateTime?
  acceptedTermsAt       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  sessions         Session[]
  authTokens       AuthToken[]
  authEvents       AuthEvent[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  ledgerEntries    LedgerEntry[]
  investments      Investment[]
  upcomingPayments UpcomingPayment[]

  @@index([status])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  newEmail   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  emailHash String?
  type      AuthEventType
  success   Boolean       @default(true)
  context   String?
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RateLimitCounter {
  bucket          String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}

/// Evidencia auditable de cada corrida del backfill de propiedad de datos.
model OwnerBackfillRun {
  id          String   @id @default(cuid())
  ownerUserId String
  dryRun      Boolean  @default(false)
  counts      String
  createdAt   DateTime @default(now())

  @@index([ownerUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Finanzas
// ---------------------------------------------------------------------------

enum AccountType {
  CASH
  BANK
  WALLET
  SAVINGS
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum UpcomingPaymentStatus {
  PENDING
  PAID
}

enum InvestmentKind {
  STOCKS
  CRYPTO
  FUND
  BOND
  REAL_ESTATE
  CASH_EQUIVALENT
  OTHER
}

enum InvestmentStatus {
  ACTIVE
  ARCHIVED
}

model Account {
  id                  String            @id @default(cuid())
  /// Propietario. Obligatorio desde 202607280001_require_financial_ownership.
  userId              String
  name                String
  type                AccountType
  currency            String            @default("ARS")
  initialBalanceCents BigInt
  status              AccountStatus     @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries             LedgerEntry[]
  sourceTransactions  Transaction[]     @relation("TransactionSource")
  targetTransactions  Transaction[]     @relation("TransactionTarget")
  upcomingPayments    UpcomingPayment[]

  @@unique([id, userId])
  @@index([status])
  @@index([userId, status])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  slug         String
  name         String
  kind         CategoryKind
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([id, userId])
  @@unique([userId, slug])
  @@index([kind])
  @@index([userId, kind])
}

model Transaction {
  id                   String           @id @default(cuid())
  userId               String
  type                 TransactionType
  amountCents          BigInt
  occurredOn           DateTime         @db.Date
  description          String?
  sourceAccountId      String
  destinationAccountId String?
  categoryId           String?
  idempotencyKey       String
  voidedAt             DateTime?
  voidReason           String?
  correctedFromId      String?          @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceAccount        Account          @relation("TransactionSource", fields: [sourceAccountId, userId], references: [id, userId], onDelete: Restrict)
  destinationAccount   Account?         @relation("TransactionTarget", fields: [destinationAccountId, userId], references: [id, userId], onDelete: Restrict)
  category             Category?        @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  entries              LedgerEntry[]
  correctedFrom        Transaction?     @relation("CorrectionChain", fields: [correctedFromId, userId], references: [id, userId], onDelete: Restrict)
  correction           Transaction?     @relation("CorrectionChain")
  upcomingPayment      UpcomingPayment?

  @@unique([id, userId])
  @@unique([correctedFromId, userId])
  @@unique([userId, idempotencyKey])
  @@index([occurredOn])
  @@index([type, occurredOn])
  @@index([sourceAccountId, occurredOn])
  @@index([destinationAccountId, occurredOn])
  @@index([userId, occurredOn])
  @@index([userId, type, occurredOn])
}

model LedgerEntry {
  id            String      @id @default(cuid())
  userId        String
  transactionId String
  accountId     String
  amountCents   BigInt
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction   Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)
  account       Account     @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)

  @@index([accountId])
  @@index([transactionId])
  @@index([userId, accountId])
}

model Investment {
  id                String           @id @default(cuid())
  userId            String
  name              String
  kind              InvestmentKind
  symbol            String?
  currency          String           @default("ARS")
  investedCents     BigInt
  currentValueCents BigInt
  note              String?
  status            InvestmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([kind])
  @@index([userId, status])
}

model UpcomingPayment {
  id               String                @id @default(cuid())
  userId           String
  concept          String
  estimatedCents   BigInt
  dueOn            DateTime              @db.Date
  frequency        String?
  plannedAccountId String
  status           UpcomingPaymentStatus @default(PENDING)
  transactionId    String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  plannedAccount   Account               @relation(fields: [plannedAccountId, userId], references: [id, userId], onDelete: Restrict)
  transaction      Transaction?          @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([transactionId, userId])
  @@index([status, dueOn])
  @@index([userId, status, dueOn])
}
