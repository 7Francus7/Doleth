{
  "name": "doleth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit --incremental false",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:backfill-owner": "tsx prisma/backfill-owner.ts",
    "db:rollback-owner": "tsx prisma/rollback-owner-backfill.ts",
    "db:preflight": "tsx prisma/ops/preflight.ts",
    "db:preflight:neon-readonly": "tsx prisma/ops/neon-production-preflight.ts",
    "db:rehearsal:seed-legacy": "tsx prisma/ops/seed-legacy-rehearsal.ts",
    "db:ensure-owner": "tsx prisma/ops/ensure-owner.ts",
    "db:audit-migrations": "tsx prisma/ops/audit-migrations.ts",
    "test:isolation": "vitest run src/test/database-required.test.ts src/lib/finance/isolation.test.ts src/app/actions/finance.authorization.test.ts src/lib/finance/ledger-integrity.test.ts src/lib/export/export-isolation.test.ts",
    "db:deletions": "tsx prisma/ops/deletion.ts",
    "db:smoke-cleanup": "tsx prisma/ops/smoke-cleanup.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "motion": "^12.42.2",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.9.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
